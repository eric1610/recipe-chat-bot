{
	"name": "recipe-chat-bot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && pnpm --package=typescript@6.0.3 --package=svelte-check@4.7.3 dlx svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && pnpm --package=typescript@6.0.3 --package=svelte-check@4.7.3 dlx svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:db": "REQUIRE_DATABASE_INTEGRATION=true vitest run --testTimeout=20000 src/lib/server/**/*.integration.test.ts",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:check": "drizzle-kit check",
		"recipe:sources:audit": "node scripts/audit-recipe-source.mjs"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "^5.0.0",
		"@skeletonlabs/skeleton-svelte": "^5.0.0",
		"@sveltejs/adapter-vercel": "6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/sanitize-html": "^2.16.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "0.31.10",
		"svelte": "^5.56.9",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@ai-sdk/svelte": "5.0.35",
		"@auth/drizzle-adapter": "1.11.3",
		"@auth/sveltekit": "1.11.3",
		"@neondatabase/serverless": "1.1.0",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"ai": "7.0.35",
		"drizzle-orm": "0.45.2",
		"htmlparser2": "12.0.0",
		"marked": "^18.0.7",
		"robots-parser": "3.0.1",
		"sanitize-html": "^2.17.6",
		"zod": "4.4.3"
	}
}
